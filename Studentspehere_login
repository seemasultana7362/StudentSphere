<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Login | EduPulse AI</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9ff;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-container-high": "#dce9ff",
                        "tertiary-fixed": "#d8e2ff",
                        "primary-container": "#131b2e",
                        "primary-fixed": "#dae2fd",
                        "inverse-on-surface": "#eaf1ff",
                        "primary-fixed-dim": "#bec6e0",
                        "on-primary": "#ffffff",
                        "error-container": "#ffdad6",
                        "outline-variant": "#c6c6cd",
                        "surface-container": "#e5eeff",
                        "secondary-fixed": "#acedff",
                        "on-tertiary-fixed": "#001a42",
                        "background": "#f8f9ff",
                        "on-error": "#ffffff",
                        "on-primary-fixed": "#131b2e",
                        "on-background": "#0b1c30",
                        "surface-variant": "#d3e4fe",
                        "tertiary": "#000000",
                        "on-tertiary-container": "#3980f4",
                        "on-surface": "#0b1c30",
                        "secondary-container": "#57dffe",
                        "on-tertiary": "#ffffff",
                        "surface-container-low": "#eff4ff",
                        "surface-dim": "#cbdbf5",
                        "on-secondary-fixed-variant": "#004e5c",
                        "on-secondary-container": "#006172",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed-variant": "#3f465c",
                        "tertiary-container": "#001a42",
                        "secondary-fixed-dim": "#4cd7f6",
                        "on-secondary-fixed": "#001f26",
                        "on-primary-container": "#7c839b",
                        "inverse-surface": "#213145",
                        "inverse-primary": "#bec6e0",
                        "error": "#ba1a1a",
                        "tertiary-fixed-dim": "#adc6ff",
                        "surface-container-lowest": "#ffffff",
                        "secondary": "#00687a",
                        "surface-bright": "#f8f9ff",
                        "surface": "#f8f9ff",
                        "outline": "#76777d",
                        "primary": "#000000",
                        "on-error-container": "#93000a",
                        "surface-container-highest": "#d3e4fe",
                        "surface-tint": "#565e74",
                        "on-surface-variant": "#45464d",
                        "on-tertiary-fixed-variant": "#004395"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "unit": "8px",
                        "margin-desktop": "40px",
                        "gutter": "24px",
                        "margin-mobile": "16px",
                        "container-max": "1440px"
                    },
                    "fontFamily": {
                        "headline-md": ["Inter"],
                        "headline-lg-mobile": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["Inter"],
                        "headline-lg": ["Inter"],
                        "label-sm": ["Inter"],
                        "display-lg": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "label-md": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "500" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "fontWeight": "600" }],
                        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }]
                    }
                },
            },
        }
    </script>
</head>

<body class="bg-background text-on-background min-h-screen flex flex-col">
    <!-- Top Navigation Bar (Shared Component) - Suppressed for Login Focus per The Filter Rule -->
    <!-- However, providing a simplified brand anchor for context -->
    <header
        class="fixed top-0 w-full z-50 bg-surface/70 backdrop-blur-xl border-b border-white/20 h-20 flex items-center px-margin-mobile md:px-margin-desktop shadow-sm shadow-secondary/5">
        <div class="flex justify-between items-center w-full max-w-container-max mx-auto">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary text-3xl" data-icon="hub">hub</span>
                <span class="font-display-lg text-headline-md font-bold text-primary">StudentSphere</span>
            </div>
            <div class="hidden md:flex items-center gap-8">
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-colors"
                    href="#">Documentation</a>
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-secondary transition-colors"
                    href="#">Support</a>
            </div>
        </div>
    </header>
    <main class="flex-grow flex items-center justify-center pt-20 pb-12 px-margin-mobile">
        <div class="w-full max-w-[1200px] grid md:grid-cols-2 gap-gutter items-center">
            <!-- Left Side: Marketing/Visual Side -->
            <div class="hidden md:flex flex-col gap-8 pr-12">
                <div class="flex flex-col gap-4">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed-variant w-fit">
                        <span class="material-symbols-outlined text-[18px]" data-icon="auto_awesome">auto_awesome</span>
                        <span class="font-label-sm text-label-sm uppercase tracking-wider">Powered by EduPulse AI</span>
                    </div>
                    <h1 class="font-display-lg text-display-lg text-on-background">Precision Intelligence for Modern
                        Learning.</h1>
                    <p class="font-body-lg text-body-lg text-on-surface-variant">The unified hub for students, faculty,
                        and administrators to manage the educational lifecycle with data-driven insights.</p>
                </div>
                <div class="relative w-full aspect-video rounded-xl overflow-hidden glass-card">
                    <img alt="Dashboard Preview" class="w-full h-full object-cover mix-blend-overlay opacity-60"
                        data-alt="A sophisticated management dashboard interface displayed on a sleek laptop screen within a brightly lit, professional high-tech office environment. The UI features elegant data visualizations, translucent glassmorphism panels, and a clean sapphire blue and electric cyan color scheme. The overall aesthetic is minimalist and authoritative, emphasizing professional educational administration and intelligent data analysis. Soft daylight floods the scene, creating a visionary and trustworthy atmosphere."
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuBOllZLOW4fNzj_cPE3iLKcg_n2VZuDKYyTco9IVHxHJGn4VNyxp7MngJCmDl1akxnm70qHG44i3M6zJq8ETM95hTVrH3UXB5vB7hmeMI1re2R6qRKfowdTPAdzFVYv6o1VAv79d01pouKmAEShT9qTAh6l_X4otXvsSZFPhgVmUHAUZMiho8_Bqjsxr8rZ277BkGFzgqUDzIbTTj9MyV9ivaP0TUTD01JP9AczrEXvYjsBVw7SnVUeGlTcWPmC1_tylw8PGKcr7JU" />
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="glass-card p-6 rounded-xl flex items-center gap-4 border-secondary/20 shadow-xl">
                            <div class="p-3 bg-secondary-container rounded-lg">
                                <span class="material-symbols-outlined text-on-secondary-container"
                                    data-icon="analytics" data-weight="fill"
                                    style="font-variation-settings: 'FILL' 1;">analytics</span>
                            </div>
                            <div>
                                <p class="font-label-sm text-label-sm text-on-surface-variant">Real-time Analytics</p>
                                <p class="font-headline-md text-headline-md text-secondary">98.4% Efficiency</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Right Side: Login Form -->
            <div class="flex justify-center">
                <div class="glass-card w-full max-w-md p-8 md:p-10 rounded-xl flex flex-col gap-8 border-white/40">
                    <div class="flex flex-col gap-2">
                        <h2 class="font-headline-lg text-headline-lg text-on-surface">Welcome Back</h2>
                        <p class="font-body-md text-body-md text-on-surface-variant">Enter your credentials to access
                            your unified portal.</p>
                    </div>
                    <!-- Social Login -->
                    <button
                        class="w-full h-12 flex items-center justify-center gap-3 bg-surface-container-lowest border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-all active:scale-[0.98]">
                        <img alt="Google" class="w-5 h-5"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBTcTY1U8omlXx0yGczC930flt8Qes7zeZnY2NUnV2ATw87UI8TyxiZn99TRfzmK07gsZ-y3bBpq2XA66OvUOAYQrFCZcqsTekeA84ZPMgegQc_2bcpQ8vkeCHioRob4GOoA3nPU9Zh1YUiWjvrJeDZ-Ud6WqZ7xeXvd4jVnpekE2-FYtfoNMasneehqbk-Nd-ODu66T_IcfxLS7DyyM4CAsq9Dkbv9wHRKvbbgrxdIBivRgbU_2B7uF4OBvZdBHzmh6tKlE0ndxUw" />
                        Sign in with Google
                    </button>
                    <div class="relative flex items-center">
                        <div class="flex-grow border-t border-outline-variant/30"></div>
                        <span
                            class="flex-shrink mx-4 font-label-sm text-label-sm text-outline uppercase tracking-widest">or
                            email login</span>
                        <div class="flex-grow border-t border-outline-variant/30"></div>
                    </div>
                    <!-- Email Login Form -->
                    <form class="flex flex-col gap-6">
                        <div class="flex flex-col gap-2">
                            <label class="font-label-sm text-label-sm text-on-surface-variant ml-1">Academic
                                Email</label>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline"
                                    data-icon="mail">mail</span>
                                <input
                                    class="w-full h-12 pl-10 pr-4 bg-surface-container-low border border-outline-variant/50 rounded-lg focus:ring-2 focus:ring-secondary-container focus:border-secondary transition-all font-body-md text-body-md"
                                    placeholder="name@studentsphere.edu" type="email" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <div class="flex justify-between items-center px-1">
                                <label class="font-label-sm text-label-sm text-on-surface-variant">Security
                                    Password</label>
                                <a class="font-label-sm text-label-sm text-secondary hover:underline" href="#">Forgot
                                    password?</a>
                            </div>
                            <div class="relative">
                                <span
                                    class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline"
                                    data-icon="lock">lock</span>
                                <input
                                    class="w-full h-12 pl-10 pr-4 bg-surface-container-low border border-outline-variant/50 rounded-lg focus:ring-2 focus:ring-secondary-container focus:border-secondary transition-all font-body-md text-body-md"
                                    placeholder="••••••••" type="password" />
                            </div>
                        </div>
                        <div class="flex items-center gap-2 px-1">
                            <input class="w-4 h-4 rounded border-outline-variant text-secondary focus:ring-secondary"
                                id="remember" type="checkbox" />
                            <label class="font-label-md text-label-md text-on-surface-variant select-none"
                                for="remember">Remember this session</label>
                        </div>
                        <button
                            class="w-full h-14 bg-primary text-on-primary rounded-lg font-label-md text-body-md font-bold shadow-lg shadow-primary/20 hover:bg-primary/90 hover:translate-y-[-2px] transition-all active:scale-[0.98]"
                            type="submit">
                            Sign In to Portal
                        </button>
                    </form>
                    <div class="text-center pt-2">
                        <p class="font-label-md text-label-md text-on-surface-variant">
                            New to StudentSphere?
                            <a class="text-secondary font-bold hover:underline" href="#">Register your role</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <!-- Footer (Shared Component) -->
    <footer class="w-full py-12 bg-surface-container-lowest border-t border-outline-variant/30 mt-auto">
        <div
            class="flex flex-col md:flex-row justify-between items-center px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto gap-gutter">
            <div class="flex flex-col items-center md:items-start gap-2">
                <span class="font-display-lg text-headline-md font-bold text-primary">StudentSphere</span>
                <p class="font-label-md text-label-md text-on-surface-variant opacity-90">© 2024 EduPulse AI. Precision
                    Intelligent Management.</p>
            </div>
            <div class="flex gap-6">
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary hover:underline transition-all"
                    href="#">Privacy Policy</a>
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary hover:underline transition-all"
                    href="#">Terms of Service</a>
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary hover:underline transition-all"
                    href="#">Documentation</a>
                <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary hover:underline transition-all"
                    href="#">Support</a>
            </div>
        </div>
    </footer>
</body>

</html>